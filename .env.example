# انسخ هذا الملف إلى .env وضع قيمك. لا ترفع .env إلى GitHub أبداً.
# Copy to .env — NEVER commit .env

# ---- LLM: any OpenAI-compatible endpoint ----
# Google Gemini (free tier available): https://aistudio.google.com/apikey
LLM_API_KEY=
# Optional: several keys, comma-separated, tried in turn when one hits its quota (overrides LLM_API_KEY)
LLM_API_KEYS=
# Tried in order when LLM_MODEL fails with 429/503/404/timeout
LLM_MODEL_FALLBACKS=gemini-3.1-flash-lite
# Per-attempt timeout / whole-chain deadline (s): after that the UI shows the cited offline quote ("وضع احتياطي")
LLM_TIMEOUT=10
LLM_DEADLINE=15
LLM_CACHE=1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
# Optional: lower latency/cost on Gemini 2.5 ("none" or "low")
LLM_REASONING_EFFORT=low
JUDGE_MODEL=gemini-3.1-flash-lite
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-4o-mini
# Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1 LLM_MODEL=llama-3.3-70b-versatile
# Local (no internet, private): Ollama -> LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=qwen2.5:7b
# Leave LLM_API_KEY empty = offline extractive mode (quotes the best passage, still with source)

# ---- Retrieval ----
# small = fast download (~470MB). Better quality: intfloat/multilingual-e5-base or BAAI/bge-m3. Empty = BM25 only.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Optional cross-encoder reranker (slower, better ranking):
RERANK_MODEL=
TOP_K=5
CHUNK_MAX_CHARS=1100
CHUNK_OVERLAP=150
# Refusal gate (calibrate with: python -m eval.run_eval)
MIN_DENSE_SCORE=0.82
MIN_TERM_COVERAGE=0.45

# ---- App ----
ADMIN_TOKEN=
UNIVERSITY_NAME=جامعة الخليل
REFERRAL_OFFICE=دائرة القبول والتسجيل أو مرشدك الأكاديمي
RATE_LIMIT_PER_MIN=30
